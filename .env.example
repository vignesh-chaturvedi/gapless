# Solami standard API key with the Developer role (https://solami.dev). Without one, `docker compose up`
# plays the recorded mainnet fixture instead.
SOLAMI_API_KEY=

# Program whose transactions Gapless follows. Default: Pump.fun.
# GAPLESS_PROGRAM=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P

# Optional overrides. Defaults are shown.
# SOLAMI_GRPC_URL=https://grpc.solami.dev
# SOLAMI_RPC_URL=https://rpc.solami.dev/sol
# SOLAMI_API_URL=https://api.solami.dev
# RUST_LOG=gapless_server=info,gapless=info
